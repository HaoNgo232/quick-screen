{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "chromium:manifest_version": 3,
  "firefox:manifest_version": 2,
  "version": "1.0.0",
  "name": "quick-shot",
  "description": "Capture full page screenshots, auto-save, and copy path for AI ingestion.",
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "64": "images/icon-64.png",
    "128": "images/icon-128.png"
  },
  "chromium:action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "quick-shot",
    "default_popup": "sidebar/index.html"
  },
  "firefox:browser_action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png",
      "64": "images/icon-64.png",
      "128": "images/icon-128.png"
    },
    "default_title": "quick-shot Side Panel"
  },
  "chromium:side_panel": {
    "default_path": "sidebar/index.html",
    "default_title": "quick-shot History & Capture"
  },
  "firefox:sidebar_action": {
    "default_panel": "sidebar/index.html",
    "default_title": "quick-shot History & Capture"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "chromium:permissions": [
    "sidePanel",
    "activeTab",
    "tabs",
    "downloads",
    "clipboardWrite",
    "storage",
    "scripting",
    "nativeMessaging"
  ],
  "firefox:permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "clipboardWrite",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "chromium:service_worker": "background.ts",
    "firefox:scripts": [
      "background.ts"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/scripts.ts"
      ]
    }
  ]
}
